// Cloudflare deployment config for Marwat Tech (via @opennextjs/cloudflare).
// Docs: https://opennext.js.org/cloudflare
//
// Public NEXT_PUBLIC_* values are also inlined at build time (see README).
// Secrets (Supabase service role, SMTP credentials) should be set with
//   `npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY`
//   `npx wrangler secret put SMTP_PASS`
// ...and never committed to git.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marwattech-company",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://marwattech.com",
    "NEXT_PUBLIC_SUPABASE_URL": "https://supabase-api.marwattech.com",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzg2NTMzNjYxLCJleHAiOjIxMDE4OTM2NjF9.TuJDKkvTQyvT4Vnm17V19bK9rmy6lL0BuDgf5poLpXQ",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyAqMTNBVct_BIZdrci9BXkogv71JkyPWTw",
    "GOOGLE_PLACE_ID": "ChIJhyLe5bY5sz4RrACxsne4xdU",
    "NEXT_PUBLIC_GTM_ID": "GTM-XXXXXXX",
    "NEXT_PUBLIC_GA_ID": "G-KL0J5YVXL5",
    "NEXT_PUBLIC_CLARITY_ID": "",
    "NEXT_PUBLIC_POSTHOG_KEY": "",
    "NEXT_PUBLIC_POSTHOG_HOST": "",
    "COURSE_DIGEST_SECRET": "cd2026-9f2b7c4e-8a1d-4f6e-9b3c-5d7e0a2f6b81"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_CACHE_WORKERS_KV",
      "id": "ad13268b6fbf45949a00136fc911cb4a"
    }
  ]
}
