# ── Marwat Tech environment variables ────────────────────────────────
# Copy to .env.local for local development. Never commit real secrets.

# Next.js public site URL (used for sitemap, canonical, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────
# Project URL + anon key from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY (admin operations, storage admin).
# NEVER expose to the browser. Used in lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email (contact/support/mockup notifications) ──────────────────────
# Option A — SMTP (cPanel mail server)
SMTP_HOST=mail.marwattech.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@marwattech.com
SMTP_PASS=your-smtp-password
# Comma-separated recipients for form notifications (or from site_settings table)
FORM_NOTIFY_EMAIL=info@marwattech.com,support@marwattech.com

# Option B — Resend (HTTP API, edge-friendly). Set RESEND_API_KEY to override SMTP.
# RESEND_API_KEY=

# ── Analytics (loaded via Google Tag Manager) ─────────────────────────
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXX
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Admin seed user (first super admin, created by seed script) ───────
SEED_ADMIN_EMAIL=admin@marwattech.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# ── Payments (PayPal Orders API v2) ───────────────────────────────────
# Optional — keys can also be added later from Admin → Settings →
# Payment Gateway (stored in the DB, staff-only). Env vars below are the
# classic alternative. If both are missing the site shows "coming soon".
PAYPAL_ENV=sandbox                    # sandbox (test) | live (production)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=         # from developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_SECRET=                 # SERVER ONLY — never expose to the browser

# ── Google OAuth (admin/client "Continue with Google") ─────────────────
# Google keys are NOT set here — configure them in the Supabase Dashboard:
#   Authentication → Providers → Google → enable + paste Client ID & Secret.
# Then add this redirect URL to your Google OAuth app:
#   https://YOUR-DOMAIN/auth/callback
# (Sandbox / local: http://localhost:3000/auth/callback)
